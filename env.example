# AWS Configuration
AWS_REGION=us-east-1
# AWS_PROFILE=default  # Uncomment to specify a named profile

# Logging configuration
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Resource limits and performance settings
S3_MAX_BUCKETS=5
S3_MAX_OBJECTS=1000
S3_MAX_CONCURRENT_BUCKETS=3
S3_MAX_RETRIES=3
S3_CONNECT_TIMEOUT=5
S3_READ_TIMEOUT=60

# Specify buckets using either method:
# Method 1: Comma-separated list
S3_BUCKETS=bucket1,bucket2,bucket3

# Method 2: Individual entries
# S3_BUCKET_1=mybucket1
# S3_BUCKET_2=mybucket2
# S3_BUCKET_3=mybucket3